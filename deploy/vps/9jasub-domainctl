#!/usr/bin/env bash
# 9jasub-domainctl -- privileged helper for reseller custom domains.
#
# The Node app (non-root) calls this through one sudoers rule. It is the ONLY
# component that writes nginx config or runs certbot, and it only ever touches
# files named <domain>.conf inside NGINX_DOMAINS_DIR. Every change is tested
# with `nginx -t` before a graceful reload and rolled back if the test fails,
# so a bad domain can never take down the other sites on this VPS.
#
# Usage: 9jasub-domainctl <prepare|issue|renew|remove|cert-info|check> [domain] [--www]
# Prints one JSON line: {"ok":true|false,"action":...,"domain":...,"message":...}
set -uo pipefail

CONF_FILE="${DOMAINCTL_CONF:-/etc/9jasub/domainctl.conf}"
# Defaults; overridden by CONF_FILE (root-owned, see deploy/vps/domainctl.conf.example).
NGINX_DOMAINS_DIR=/etc/nginx/9jasub-domains
ACME_WEBROOT=/var/www/9jasub-acme
UPSTREAM=127.0.0.1:8800
CERT_LIVE_DIR=/etc/letsencrypt/live
CERTBOT_BIN=certbot
CERTBOT_EMAIL=
ACME_STAGING=0
NGINX_BIN=nginx
RELOAD_CMD="systemctl reload nginx"
LOCK_FILE=/run/9jasub-domainctl.lock
LISTEN_IPV6=1
# HTTP/2 is a per-socket option in nginx: enabling it here also enables it for
# every other site on port 443. Leave 0 unless all sites on the VPS use http2.
LISTEN_HTTP2=0

if [[ -f "$CONF_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$CONF_FILE"
fi

json_escape() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\n'/ }; s=${s//$'\r'/ }; s=${s//$'\t'/ }; printf '%s' "$s"; }
out() { # ok action domain message [extra-json]
    printf '{"ok":%s,"action":"%s","domain":"%s","message":"%s"%s}\n' "$1" "$2" "$3" "$(json_escape "$4")" "${5:-}"
}
fail() { out false "$ACTION" "${DOMAIN:-}" "$1"; exit "${2:-1}"; }

ACTION="${1:-}"
DOMAIN="${2:-}"
WWW=0
[[ "${3:-}" == "--www" ]] && WWW=1

# Same rules as services/domains/domainValidation.js: lowercase ASCII labels,
# no leading/trailing hyphen, alphabetic or punycode TLD, max 253 chars.
valid_domain() {
    local d="$1"
    [[ ${#d} -le 253 ]] || return 1
    [[ "$d" =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+([a-z]{2,63}|xn--[a-z0-9-]{1,59})$ ]] || return 1
    [[ "$d" != www.* ]] || return 1
    return 0
}

case "$ACTION" in
    prepare|issue|renew|remove|cert-info) valid_domain "$DOMAIN" || fail "Invalid domain name." 2 ;;
    check) ;;
    *) out false "${ACTION:-none}" "" "Unknown action. Use prepare|issue|renew|remove|cert-info|check."; exit 2 ;;
esac

CONF_PATH="$NGINX_DOMAINS_DIR/$DOMAIN.conf"
BACKUP_DIR="$NGINX_DOMAINS_DIR/.backup"
SERVER_NAMES="$DOMAIN"
[[ $WWW -eq 1 ]] && SERVER_NAMES="$DOMAIN www.$DOMAIN"
CERT_DIR="$CERT_LIVE_DIR/$DOMAIN"

# One change at a time: concurrent reloads/certbot runs are serialized.
exec 9>"$LOCK_FILE" || fail "Cannot open lock file $LOCK_FILE."
flock -w 120 9 || fail "Another domain operation is still running; try again shortly."

listen_lines() { # port [ssl]
    local extra="${2:-}"
    echo "    listen $1${extra:+ $extra};"
    [[ "$LISTEN_IPV6" == "1" ]] && echo "    listen [::]:$1${extra:+ $extra};"
}

# nginx workers run unprivileged and must be able to read challenge files.
ensure_webroot() {
    mkdir -p "$ACME_WEBROOT/.well-known/acme-challenge" || fail "Cannot create $ACME_WEBROOT."
    chmod 755 "$ACME_WEBROOT" "$ACME_WEBROOT/.well-known" "$ACME_WEBROOT/.well-known/acme-challenge"
}

common_http_locations() {
    cat <<EOF
    location ^~ /.well-known/acme-challenge/ {
        root $ACME_WEBROOT;
        default_type text/plain;
    }
    location = /.well-known/9jasub-probe {
        default_type text/plain;
        return 200 "$DOMAIN";
    }
EOF
}

proxy_block() {
    cat <<EOF
    location / {
        proxy_pass http://$UPSTREAM;
        proxy_http_version 1.1;
        # Always overwrite client-supplied host headers: the app picks the
        # reseller from X-Forwarded-Host / Host, so they must come from nginx.
        proxy_set_header Host \$host;
        proxy_set_header X-Forwarded-Host \$host;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection \$http_connection;
        proxy_read_timeout 120s;
    }
EOF
}

render_http_only() {
    cat <<EOF
# 9jasub-managed: $DOMAIN (stage: http) -- generated by 9jasub-domainctl, do not edit
server {
$(listen_lines 80)
    server_name $SERVER_NAMES;
$(common_http_locations)
    location / {
        default_type text/plain;
        return 503 "This website is being set up. Please check back shortly.";
    }
}
EOF
}

render_https() {
    local SSL_LISTEN_OPTS="ssl"
    [[ "$LISTEN_HTTP2" == "1" ]] && SSL_LISTEN_OPTS="ssl http2"
    cat <<EOF
# 9jasub-managed: $DOMAIN (stage: https) -- generated by 9jasub-domainctl, do not edit
server {
$(listen_lines 80)
    server_name $SERVER_NAMES;
$(common_http_locations)
    location / {
        return 301 https://\$host\$request_uri;
    }
}

server {
$(listen_lines 443 "$SSL_LISTEN_OPTS")
    server_name $SERVER_NAMES;

    ssl_certificate $CERT_DIR/fullchain.pem;
    ssl_certificate_key $CERT_DIR/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:9jasub_ssl:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 20m;

    location = /.well-known/9jasub-probe {
        default_type text/plain;
        return 200 "$DOMAIN";
    }
$(proxy_block)
}
EOF
}

# Refuse a hostname that any nginx config outside our directory already
# serves: another application on this VPS must never be taken over.
conflict_check() {
    local dump
    if ! dump=$("$NGINX_BIN" -T 2>"$LOCK_FILE.err"); then
        fail "nginx -T failed; fix the current nginx configuration before adding domains: $(grep -v '^\s*$' "$LOCK_FILE.err" | grep -viE 'syntax is ok|test is successful' | tail -2)"
    fi
    local hits
    hits=$(awk -v ours="$NGINX_DOMAINS_DIR/" -v names="$SERVER_NAMES" '
        BEGIN { n = split(names, want, " ") }
        /^# configuration file / { file = $4; sub(/:$/, "", file); next }
        index(file, ours) == 1 { next }
        {
            # server_name may share a line with other directives
            # ("server { listen 80; server_name a.com; ... }").
            line = $0; sub(/#.*/, "", line)
            while (match(line, /(^|[;{ \t])server_name[ \t]+[^;]*/)) {
                names = substr(line, RSTART, RLENGTH); line = substr(line, RSTART + RLENGTH)
                sub(/^[;{ \t]*server_name[ \t]+/, "", names)
                m = split(names, got, /[ \t]+/)
                for (i = 1; i <= m; i++) for (j = 1; j <= n; j++) if (tolower(got[i]) == want[j]) print file ": " got[i]
            }
        }' <<<"$dump")
    [[ -z "$hits" ]] || fail "Refused: already served by another site on this server ($(echo "$hits" | head -3 | tr '\n' ' '))." 3
}

# Writes new config atomically, tests it, reloads; restores the previous
# file (or removes the new one) if nginx rejects it.
install_conf() { # content
    mkdir -p "$NGINX_DOMAINS_DIR" "$BACKUP_DIR" || fail "Cannot create $NGINX_DOMAINS_DIR."
    local tmp="$NGINX_DOMAINS_DIR/.$DOMAIN.conf.tmp" had_old=0
    if [[ -f "$CONF_PATH" ]]; then cp -p "$CONF_PATH" "$BACKUP_DIR/$DOMAIN.conf.bak"; had_old=1; fi
    printf '%s\n' "$1" >"$tmp" && mv -f "$tmp" "$CONF_PATH" || { rm -f "$tmp"; fail "Cannot write $CONF_PATH."; }
    local test_out
    if ! test_out=$("$NGINX_BIN" -t 2>&1); then
        if [[ $had_old -eq 1 ]]; then mv -f "$BACKUP_DIR/$DOMAIN.conf.bak" "$CONF_PATH"; else rm -f "$CONF_PATH"; fi
        fail "nginx rejected the generated config; previous config restored. $(echo "$test_out" | tail -3)" 4
    fi
    reload_nginx
}

reload_nginx() {
    local r
    r=$(bash -c "$RELOAD_CMD" 2>&1) || fail "nginx reload failed: $r" 5
}

cert_expiry_json() {
    [[ -f "$CERT_DIR/fullchain.pem" ]] || { echo ""; return; }
    local end issuer
    end=$(openssl x509 -enddate -noout -in "$CERT_DIR/fullchain.pem" 2>/dev/null | cut -d= -f2-)
    issuer=$(openssl x509 -issuer -noout -in "$CERT_DIR/fullchain.pem" 2>/dev/null | sed 's/^issuer=\s*//')
    printf ',"notAfter":"%s","issuer":"%s"' "$(json_escape "$end")" "$(json_escape "$issuer")"
}

run_certbot() { # extra args...
    [[ -n "$CERTBOT_EMAIL" ]] || fail "CERTBOT_EMAIL is not set in $CONF_FILE." 6
    local args=(certonly --webroot -w "$ACME_WEBROOT" --cert-name "$DOMAIN" -d "$DOMAIN"
        --non-interactive --agree-tos -m "$CERTBOT_EMAIL" --keep-until-expiring --expand
        --deploy-hook "$RELOAD_CMD")
    [[ $WWW -eq 1 ]] && args+=(-d "www.$DOMAIN")
    [[ "$ACME_STAGING" == "1" ]] && args+=(--staging)
    local cb_out
    if ! cb_out=$("$CERTBOT_BIN" "${args[@]}" 2>&1); then
        fail "Let's Encrypt did not issue the certificate: $(echo "$cb_out" | grep -iE 'error|detail|rate|limit|problem' | tail -4)" 7
    fi
}

case "$ACTION" in
    check)
        "$NGINX_BIN" -t >/dev/null 2>&1 || fail "nginx -t fails with the current configuration."
        dump=$("$NGINX_BIN" -T 2>/dev/null)
        grep -q "include $NGINX_DOMAINS_DIR/\*.conf" <<<"$dump" || fail "nginx does not include $NGINX_DOMAINS_DIR/*.conf yet (see DOMAINS_SETUP.md)."
        [[ -d "$ACME_WEBROOT" ]] || fail "ACME webroot $ACME_WEBROOT does not exist."
        command -v "$CERTBOT_BIN" >/dev/null 2>&1 || fail "certbot not found ($CERTBOT_BIN)."
        out true check "" "Domain provisioning is ready."
        ;;
    prepare)
        conflict_check
        ensure_webroot
        # Keep a working HTTPS config if one exists (re-prepare after www change).
        if [[ -f "$CERT_DIR/fullchain.pem" && -f "$CONF_PATH" ]] && grep -q "(stage: https)" "$CONF_PATH"; then
            install_conf "$(render_https)"
        else
            install_conf "$(render_http_only)"
        fi
        out true prepare "$DOMAIN" "HTTP site prepared for verification."
        ;;
    issue)
        conflict_check
        ensure_webroot
        [[ -f "$CONF_PATH" ]] || install_conf "$(render_http_only)"
        run_certbot
        [[ -f "$CERT_DIR/fullchain.pem" ]] || fail "certbot finished but $CERT_DIR/fullchain.pem is missing." 7
        install_conf "$(render_https)"
        out true issue "$DOMAIN" "Certificate issued and HTTPS enabled." "$(cert_expiry_json)"
        ;;
    renew)
        cb_out=$("$CERTBOT_BIN" renew --cert-name "$DOMAIN" --non-interactive --deploy-hook "$RELOAD_CMD" 2>&1) \
            || fail "Renewal failed: $(echo "$cb_out" | grep -iE 'error|detail|rate|limit|problem' | tail -4)" 7
        out true renew "$DOMAIN" "Renewal ran." "$(cert_expiry_json)"
        ;;
    remove)
        if [[ -f "$CONF_PATH" ]]; then
            mkdir -p "$BACKUP_DIR"
            mv -f "$CONF_PATH" "$BACKUP_DIR/$DOMAIN.conf.removed"
            if ! test_out=$("$NGINX_BIN" -t 2>&1); then
                mv -f "$BACKUP_DIR/$DOMAIN.conf.removed" "$CONF_PATH"
                fail "nginx -t failed after removal; config restored. $(echo "$test_out" | tail -2)" 4
            fi
            reload_nginx
        fi
        if [[ -d "$CERT_DIR" ]]; then
            "$CERTBOT_BIN" delete --cert-name "$DOMAIN" --non-interactive >/dev/null 2>&1 || true
        fi
        out true remove "$DOMAIN" "Domain removed from nginx."
        ;;
    cert-info)
        info=$(cert_expiry_json)
        [[ -n "$info" ]] || fail "No certificate for $DOMAIN." 8
        out true cert-info "$DOMAIN" "Certificate found." "$info"
        ;;
esac
