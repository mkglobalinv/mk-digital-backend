# URL of the main app (login, signup, dashboard) linked from the marketing site
NEXT_PUBLIC_APP_URL=https://app.9jasub.com

# Android APK download URL (see src/lib/appConfig.ts)
NEXT_PUBLIC_APP_DOWNLOAD_URL=
NEXT_PUBLIC_APP_STORE_TYPE=apk

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
# Leave unset to disable GA4 tracking.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta (Facebook) Pixel Dataset ID from Meta Events Manager.
# This is a public client-side identifier, not a secret.
# Leave unset to disable the Meta Pixel.
NEXT_PUBLIC_META_PIXEL_ID=1514926323654640
