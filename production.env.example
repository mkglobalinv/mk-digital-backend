# PRODUCTION ENVIRONMENT VARIABLES
# Replace values with your actual production secrets

PORT=8800
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
JWT_SECRET=generate_a_secure_random_string_here

# Flutterwave (Live Mode)
FLW_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLW_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLW_ENCRYPTION_KEY=FLWSECK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLW_WEBHOOK_HASH=your_webhook_hash

# SMTP / Email Configuration
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
ADMIN_EMAIL=your_email@gmail.com

# VTU PROVIDERS
CLUBKONNECT_BASE_URL=https://www.nellobytesystems.com
CLUBKONNECT_USERID=CK101276060
CLUBKONNECT_API_KEY=your_clubkonnect_key

PEYFLEX_API_URL=https://client.peyflex.com.ng
PEYFLEX_API_TOKEN=your_peyflex_token

JARAPOINT_BASE_URL=https://jarapoint.com/api
JARAPOINT_API_KEY=your_jarapoint_key

RELOADLY_CLIENT_ID=your_reloadly_client_id
RELOADLY_CLIENT_SECRET=your_reloadly_client_secret
RELOADLY_BASE_URL=https://topups.reloadly.com

CONNECTBRIDGE_BASE_URL=https://connectbridge.com.ng/api
CONNECTBRIDGE_API_KEY=your_connectbridge_key

# SUPABASE CONFIG (APK STORAGE)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_key
