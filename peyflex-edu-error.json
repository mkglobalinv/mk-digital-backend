opup-overlay {\n                  display: none;\n                  position: fixed;\n                  top: 0;\n                  left: 0;\n                  width: 100%;\n                  height: 100%;\n                  background: rgba(0, 0, 0, 0.5);\n                  z-index: 1000;\n                }\n            \n                /* Modal content */\n                .popup-content {\n                  position: absolute;\n                  top: 50%;\n                  left: 50%;\n                  transform: translate(-50%, -50%);\n                  background: #fff;\n                  padding: 20px;\n                  border-radius: 8px;\n                  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.25);\n                  text-align: center;\n                  z-index: 1001;\n                }\n            \n                /* Popup heading */\n                .popup-content h2 {\n                  margin: 0 0 10px;\n                  font-size: 1.5rem;\n                }\n            \n                /* Buttons */\n                .popup-button {\n                  display: inline-block;\n                  margin-top: 15px;\n                  padding: 10px 20px;\n                  border: none;\n                  border-radius: 5px;\n                  font-size: 1rem;\n                  cursor: pointer;\n                  background: #f44336;\n                  color: #fff;\n                }\n              </style>\n            \n            <body>\n            \n              <!-- Popup structure -->\n              <div class=\"popup-overlay\" id=\"popup\">\n                <div class=\"popup-content\">\n                  <h2>Multiple Tabs Detected!</h2>\n                  <p>You cannot open multiple tabs on this portal.</p>\n                  <button class=\"popup-button\" id=\"okayButton\">Okay</button>\n                </div>\n              </div>\n            \n              <!-- JavaScript -->\n              <script>\n                const channel = new BroadcastChannel('tab');\n                const popup = document.getElementById('popup');\n                const okayButton = document.getElementById('okayButton');\n            \n                // Add event listener for incoming messages\n                channel.addEventListener('message', (msg) => {\n                  if (msg.data === 'another-tab') {\n                    // Show the popup when another tab is detected\n                    popup.style.display = 'block';\n            \n                    // Auto-logout after showing the popup\n                    setTimeout(() => {\n                      const redirectUrl = \"/account/logout/\";\n                      location.href = redirectUrl;\n                    }, 5000); // Auto-logout after 5 seconds\n                  }\n                });\n            \n                // Notify other tabs that this tab is opened\n                channel.postMessage('another-tab');\n            \n                // Okay button functionality\n                okayButton.addEventListener('click', () => {\n                  const redirectUrl = \"/account/logout/\"; // Django logout URL\n                  location.href = redirectUrl;\n                });\n            \n                // Close the popup when the tab is closed\n                window.addEventListener('beforeunload', () => {\n                  popup.style.display = 'none';\n                });\n              </script>\n            </body>\n\n    <main class=\"main-wrapper col-md-9 ms-sm-auto py-4 col-lg-9 px-md-4 border-start\">\n        <div class=\"title-group mb-3\">\n            <h1 class=\"h2 mb-0\">Page Not Found</h1>\n        </div>\n\n        <div class=\"row my-4\">\n            <div class=\"col-lg-12 text-center\">\n                <div class=\"custom-block custom-block-profile p-4\">\n                    <img src=\"https://spacepay.ng/static/img/404-page.svg\" alt=\"404 Not Found\" style=\"max-width: 100%; height: auto;\">\n                    <p class=\"mt-3\">Oops! The page you're looking for doesn't exist.</p>\n                    <a href=\"/account/dashboard/\" class=\"btn mt-2\" style=\"background-color: #4c00b0; color: #fff; padding: 8px 20px; font-size: 14px; border-radius: 6px; text-decoration: none;\">\n                        Back to Dashboard\n                    </a>\n                </div>\n            </div>\n        </div>\n    </main>\n</body>\n</html>\n"
